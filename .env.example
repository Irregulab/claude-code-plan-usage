# Shared secret between agent and server — generate with: openssl rand -hex 32
AGENT_TOKEN=change-me

# --- server ---
PORT=8787
STALE_MS=60000
STALE_CHECK_MS=15000

# --- agent ---
SERVER_URL=http://localhost:8787
POLL_MS=10000
# Optional label shown in the dashboard footer
AGENT_HOST_LABEL=

# --- plan usage (agent) ---
# Real percentages come from Anthropic's /api/oauth/usage endpoint.
# Token is auto-read from the macOS Keychain (service: Claude Code-credentials)
# or ~/.claude/.credentials.json on Linux/Windows. Override here if needed:
# CLAUDE_OAUTH_TOKEN=sk-ant-oat01-...
