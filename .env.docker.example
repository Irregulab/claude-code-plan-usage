# Public domain pointing to this host (DNS A/AAAA must resolve before `up`)
DOMAIN=usage.example.com

# Used by Let's Encrypt for cert expiry notifications
LETSENCRYPT_EMAIL=you@example.com

# Shared secret with the agent (same as direct deploy) — generate with: openssl rand -hex 32
AGENT_TOKEN=change-me

# Optional — same defaults as the direct deploy
STALE_MS=60000
STALE_CHECK_MS=15000
